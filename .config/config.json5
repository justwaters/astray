{
  "keybindings": {
    "Main": {
      "<q>": "Quit", // Quit the application
      "<Ctrl-d>": "Quit", // Another way to quit
      "<Ctrl-c>": "Quit", // Yet another way to quit
      "<Ctrl-z>": "Suspend", // Suspend the application
      "<Alt-s>": "StartSelecting",
      "<Tab>": "NavigateNextTab",
      "<BackTab>": "NavigatePrevTab",
      "<Alt-r>": "MainAction",
      "<Alt-f>": "SecondaryAction",
      "<Alt-h>": "Help",
      // Plain-letter fallbacks for the Alt-shortcuts above: some terminals (notably
      // macOS Terminal.app, by default) don't send Option/Alt as a Meta sequence,
      // which would otherwise make every Alt-bound action silently do nothing.
      "<s>": "StartSelecting",
      "<r>": "MainAction",
      "<f>": "SecondaryAction",
      "<h>": "Help",
      // Quick-travel shortcuts for the System View tab, so engaging the enemy or
      // heading home doesn't require manually paging through the body list first.
      "<Alt-e>": "EngageEnemy",
      "<e>": "EngageEnemy",
      "<Alt-c>": "ReturnToCapital",
      "<c>": "ReturnToCapital"
    },
    "Help": {
      "<Enter>": "Select",
      "<Esc>": "Select"
    },
    "SelectingBodyInSystemTree": {
      "<Up>": "SelectPrevious",
      "<Down>": "SelectNext",
      "<Enter>": "Select",
      "<Esc>": "Select",
    },
    "SelectingResearchField": {
      "<Up>": "SelectPrevious",
      "<Down>": "SelectNext",
      "<Enter>": "ContinueSelecting",
      "<Esc>": "Select",
    },
    "SelectingResearch": {
      "<Up>": "SelectPrevious",
      "<Down>": "SelectNext",
      "<Enter>": "Select",
      "<Esc>": "Select",
    },
    "SelectingColony": {
      "<Up>": "SelectPrevious",
      "<Down>": "SelectNext",
      "<Enter>": "Select",
      "<Esc>": "Select",
    },
    "SelectingBuilding": {
      "<Up>": "SelectPrevious",
      "<Down>": "SelectNext",
      "<Enter>": "Select",
      "<Esc>": "Select",
    },
    "SystemMapNavigation": {
      "<Up>": "Up",
      "<Down>": "Down",
      "<Left>": "Left",
      "<Right>": "Right",
      "<]>": "ZoomOut",
      "<[>": "ZoomIn",
      "<Enter>": "Select",
      "<Esc>": "Select"
    },
    "SelectingShipModuleType": {
      "<Up>": "SelectPrevious",
      "<Down>": "SelectNext",
      "<Enter>": "ContinueSelecting",
      "<Esc>": "Select"
    },
    "SelectingShipModule": {
      "<Up>": "SelectPrevious",
      "<Down>": "SelectNext",
      "<Enter>": "Select",
      "<Esc>": "Select"
    }
  }
}
